{
  "name": "voklumi",
  "version": "0.1.0",
  "description": "Voklumi Telegram Mini App foundation",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "test:auth": "node --import tsx --test tests/auth/*.test.ts",
    "telegram:setup": "node --env-file-if-exists=.env.local scripts/setup-telegram.mjs",
    "test:lessons": "node scripts/test-lessons.mjs",
    "content:check": "node scripts/import-content.mjs",
    "content:import": "node --env-file-if-exists=.env.local scripts/import-content.mjs --apply",
    "test:content": "node scripts/test-content.mjs",
    "test:gamification": "node scripts/test-gamification.mjs",
    "db:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-supabase.ts",
    "test:supabase": "node --import tsx --test tests/supabase/*.test.ts",
    "test:social": "node scripts/test-social.mjs",
    "test:payments": "node --import tsx --test tests/payments/*.test.ts && node scripts/test-payments.mjs",
    "stars:refund": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/refund-stars.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeperGT45/My_saas2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/FeperGT45/My_saas2/issues"
  },
  "homepage": "https://github.com/FeperGT45/My_saas2#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tma.js/sdk-react": "^3.0.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
