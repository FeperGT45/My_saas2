# Local demo is allowed ONLY in development; never provides authentication.
NEXT_PUBLIC_ENABLE_LOCAL_DEMO=true
# Optional: leave empty to run without Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; Telegram initData verification and bot API. Never NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
# Optional server-only privileged key; never expose to NEXT_PUBLIC_* or browser.
# Used by server-side Telegram provisioning/sessions and future trusted grader jobs.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical public HTTPS origin (no trailing path). Required for production auth/webhook.
APP_URL=
TELEGRAM_BOT_USERNAME=Voklumi_bot
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# SERVER ONLY. Local auth additionally requires NODE_ENV=development + loopback URL.
ENABLE_LOCAL_AUTH=false
LOCAL_AUTH_SECRET=
# Preferred modern Supabase server secret key. If set, takes precedence over legacy service-role JWT.
# Keep ONLY in server/runtime secrets; never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional operations-only bearer secret (32+ chars); enables GET /api/health/database.
SUPABASE_HEALTHCHECK_SECRET=
# Migration CLI only (not required by the app):
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Node.js 24 in proxied Codex Cloud: honor configured HTTP_PROXY/HTTPS_PROXY.
# Non-secret runtime setting; needed in this managed environment.
NODE_USE_ENV_PROXY=1
# Optional BotFather Mini App short name; blank uses the bot's Main Mini App link.
TELEGRAM_MINI_APP_SLUG=
# Payments stay disabled until the owner verifies the implementation and policies.
TELEGRAM_STARS_PAYMENTS_ENABLED=false
TELEGRAM_STARS_OWNER_REVIEWED=false
# Prices are fixed in src/lib/billing/plans.ts: 49 Stars / 7 days, 149 / 30 days.
PREMIUM_TERMS_URL=
# Support is fixed to https://t.me/feper145 in the same catalog.
# Refunds require a separate switch and explicit operator CLI confirmation.
TELEGRAM_STARS_REFUNDS_ENABLED=false
STARS_REFUND_ORDER_ID=

# SERVER ONLY. Comma-separated internal user UUIDs, never Telegram usernames or client roles.
# Empty disables admin access. Local demo authentication is always denied.
ADMIN_USER_IDS=

# Cloudflare Workers: build with Node.js 24.22.0 (.node-version).
# NEXT_PUBLIC_* and APP_URL must also be supplied to the Cloudflare BUILD environment.
# Runtime secrets go in Workers Settings > Variables and Secrets; never in this file.
# CLI/CI deployment only; not used by application runtime.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Local Worker secrets may be placed in ignored .dev.vars (not committed).

# Placement (Stage A) reuses the Supabase server environment above; no new keys.
# Apply placement_assessment and import supabase/placement-seed.sql before deployment.
# npm run placement:check verifies the bank and private RPCs; never expose answers via NEXT_PUBLIC_*.
# Learning paths (Stage B) reuse the same server environment; no new keys.
# Apply personal_learning_paths after Stage A; npm run learning:check verifies private access.
# Exercise types (Stage C) reuse the same server secrets; no paid API or new key.
# Apply interactive_exercise_types before deployment; npm run exercises:check verifies readiness.

# Modular library (Stage D): reuse the same Supabase server key; no new secret.
# Apply modular_curriculum_import, then library:import; library:db-check gates production builds.
