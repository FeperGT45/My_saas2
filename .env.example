# Local demo is allowed ONLY in development; never provides authentication.
NEXT_PUBLIC_ENABLE_LOCAL_DEMO=true
# Optional: leave empty to run without Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; reserved for future Telegram initData validation. Never NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
