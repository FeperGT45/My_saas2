# Local demo is allowed ONLY in development; never provides authentication.
NEXT_PUBLIC_ENABLE_LOCAL_DEMO=true
# Optional: leave empty to run without Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; Telegram initData verification and bot API. Never NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
# Optional server-only privileged key; never expose to NEXT_PUBLIC_* or browser.
# Used by server-side Telegram provisioning/sessions and future trusted grader jobs.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical public HTTPS origin (no trailing path). Required for production auth/webhook.
APP_URL=
TELEGRAM_BOT_USERNAME=Voklumi_bot
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# SERVER ONLY. Local auth additionally requires NODE_ENV=development + loopback URL.
ENABLE_LOCAL_AUTH=false
LOCAL_AUTH_SECRET=
# Preferred modern Supabase server secret key. If set, takes precedence over legacy service-role JWT.
# Keep ONLY in server/runtime secrets; never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional operations-only bearer secret (32+ chars); enables GET /api/health/database.
SUPABASE_HEALTHCHECK_SECRET=
# Migration CLI only (not required by the app):
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
